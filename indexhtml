<!DOCTYPE html>
<html lang="en">
<head>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>For You 🤍</title>

<style>
body {
  margin: 0;
  background: #0b0b0b;
  font-family: 'Georgia', serif;
  color: white;
  overflow-x: scroll;
}

/* INTRO */
#intro {
  position: fixed;
  width: 100%;
  height: 100%;
  background: black;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 1.5rem;
  z-index: 10;
  
}

@keyframes fadeOut {
  to { opacity: 0; visibility: hidden; }
}

.gallery{
    display:flex;
    overflow-x:auto;
    overflow-y:hidden;
    scroll-snap-type:x mandatory;
    scroll-behavior:smooth;
    height:100vh;
}

.gallery::-webkit-scrollbar{
    display:none;
}

/* ART BLOCK */
.art{
    min-width:100vw;
    height:100vh;

    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;

    scroll-snap-align:center;
    position:relative;
}
/* FRAME */
.frame{
    width:85vw;
    max-width:340px;
    aspect-ratio:3/4;

    background:#111;
    border:10px solid #444;
    overflow:hidden;

    box-shadow:0 15px 40px rgba(0,0,0,.6);

    transition:.5s;
}

.frame img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.frame:hover {
  transform: scale(1.1);
  box-shadow: 0 0 80px rgba(255,255,255,0.4);
}

/* SPOTLIGHT */
.art::before {
  content: "";
  position: absolute;
  top: -120px;
  width: 200px;
  height: 200px;
  background: radial-gradient(circle, rgba(255,255,255,0.25), transparent);
}

/* CAPTION */
.caption{
    width:85vw;
    max-width:340px;

    margin-top:25px;

    text-align:center;
    font-size:16px;
    line-height:1.7;

    color:#f5f5f5;
}

/* NAME */
#nameTag {
  position: fixed;
  bottom: 20px;
  right: 20px;
  opacity: 0.5;
  font-size: 0.9rem;
}
#intro {
  position: fixed;
  width: 100%;
  height: 100%;
  background: black;
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
  z-index: 10;
}

#introText {
  font-size: 1.5rem;
  opacity: 0;
  transition: 1s;
}
#finalMessage {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: black;
  color: white;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  opacity: 0;
  transition: 1s;
  text-align: center;
  padding: 20px;
}

#finalMessage.show {
  opacity: 1;
}
.gallery {
  scroll-snap-type: x mandatory;
}

.art {
  scroll-snap-align: center;
}
@media (max-width:768px){

.gallery{
    gap:40px;
    padding:40px 20px;
}

.frame{
    width:85vw;
    max-width:320px;
}

.caption{
    width:85vw;
    font-size:14px;
}

#introText{
    font-size:1.2rem;
    padding:20px;
}

#finalMessage h1{
    font-size:2rem;
}

#finalMessage p{
    font-size:15px;
    line-height:1.7;
}

#nameTag{
    font-size:13px;
    right:15px;
    bottom:15px;
}

}
</style>
</head>

<body>

<div id="intro">
  <div id="introText"></div>
</div>

<!-- MUSIC -->
<audio id="bgm" loop>
  <source src="music.mp3" type="audio/mpeg">
</audio>

<div class="gallery" id="gallery">

  <div class="art">
    <div class="frame"><img src="img1.jpg"></div>
    <div class="caption">Bersamamu, aku belajar bahwa rasa nyaman ternyata bisa sesederhana saling menggenggam dan saling menemani.</div>
  </div>

  <div class="art">
    <div class="frame"><img src="img2.jpg"></div>
    <div class="caption">Terima kasih sudah menjadi rumah yang selalu membuatku ingin pulang, di tengah segala lelah dan sibuknya dunia.</div>
  </div>

  <div class="art">
    <div class="frame"><img src="img3.jpg"></div>
    <div class="caption">Terima kasih sudah menjadi rumah yang selalu membuatku ingin pulang, di tengah segala lelah dan sibuknya dunia.</div>
  </div>

  <div class="art">
    <div class="frame"><img src="img4.jpg"></div>
    <div class="caption">Aku berharap akan ada lebih banyak foto, lebih banyak tawa, dan lebih banyak cerita yang bisa kita buat bersama.</div>
  </div>

  <div class="art">
    <div class="frame"><img src="img5.jpg"></div>
    <div class="caption">I love you today, tomorrow and forever.</div>
  </div>
  <div id="finalMessage">
  <h1>I Love You Baby🤍</h1>
  <p>
    I didn’t put this in the frames…  
    because this one is different.
    <br><br>
    I just want you to know…  
    you’re appreciated, more than you realize.
    <br><br>
    And I’m really glad you exist.
  </p>
</div>

</div>

<div id="nameTag"></div>

<script>
/* NAME */
let name = prompt("Who is this masterpiece? 🤍") || "You";
document.getElementById("nameTag").innerText = name;

/* MUSIC AUTOPLAY FIX */
const music = document.getElementById("bgm");
document.body.addEventListener("click", () => {
  music.play();
}, { once: true });

/* AUTO SCROLL */
let scrollPos = 0;
function autoScroll(){
  scrollPos += 0.3;
  const gallery = document.getElementById("gallery");

let current = 0;

function nextSlide(){

    const cards = document.querySelectorAll(".art");

    if(current < cards.length-1){

        current++;

        gallery.scrollTo({
            left: current * window.innerWidth,
            behavior:"smooth"
        });

        setTimeout(nextSlide,5000);

    }

}

setTimeout(nextSlide,5000);
  requestAnimationFrame(autoScroll);
}
setTimeout(autoScroll, 4000);
const introText = document.getElementById("introText");

const introLines = [
  "Hi...",
  "Welcome to our mini art gallery.",
  "There’s something I want to show you."
];

let i = 0;

function showIntro() {
  if (i < introLines.length) {
    introText.style.opacity = 0;

    setTimeout(() => {
      introText.innerText = introLines[i];
      introText.style.opacity = 1;
      i++;
      setTimeout(showIntro, 2000);
    }, 500);
  } else {
    // hilangkan intro
    document.getElementById("intro").style.opacity = 0;
    setTimeout(() => {
      document.getElementById("intro").style.display = "none";
    }, 1000);
  }
}

showIntro();
setTimeout(() => {
  document.getElementById("finalMessage").classList.add("show");
}, 25000);

</script>

</body>
</html>
